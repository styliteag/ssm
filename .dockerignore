# Build context is the repository root; the image needs phoenix/ sources,
# VERSION, LICENSE, and THIRD-PARTY-LICENSES.md — everything else stays out.

# Databases — never bake data into the image
*.db
*.db-*
ssm.db*

# Elixir build caches and dev artifacts (docker-only dev toolchain)
phoenix/data/
phoenix/deps/
phoenix/_build/
phoenix/tmp/
phoenix/.htpasswd

# SSH keys and sensitive data
phoenix/keys/
*.pem
*.key
*.crt
*.p12
id_rsa*
id_ed25519*
id_ssm*
known_hosts
authorized_keys
.env
.env.*
.htpasswd
.htuploaders

# VCS, editors, CI
.git/
.gitignore
.github/
.githooks/
.vscode/
.idea/
*.log
*.swp
*.swo
*~

# Docs and metadata (license attribution must travel in the image)
README.md
*.md
docs/
!THIRD-PARTY-LICENSES.md
LICENSE.txt
!LICENSE

# Dev tooling
justfile
release.sh
install-hooks.sh
scripts/
sbom.cdx.json

# Docker and compose files (avoid recursive copying)
docker/
docker-compose*.yml
compose*.yml

# OS artifacts
.DS_Store
Thumbs.db
