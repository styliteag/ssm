# Dev image (docker-only toolchain, like ../link-shortener ADR-0007).
# cmake: lazy_html/lexbor source build. inotify-tools: live reload.
# Elixir/OTP: the one source is .tool-versions next to this file (test/tool_versions_test.exs
# checks these ARGs against it). The official elixir image pins OTP to its
# major only; .tool-versions carries the exact OTP for local/CI toolchains.
ARG ELIXIR_VERSION=1.20.5
ARG OTP_VERSION=29
FROM elixir:${ELIXIR_VERSION}-otp-${OTP_VERSION}

RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake inotify-tools openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
